#!/usr/bin/env bash
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -e) shift ;;
    *) args+=("${1/#fakehost:/}") ;;
  esac
  shift
done

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
clean_path="$(tr ':' '\n' <<<"$PATH" | grep -vxF -- "$here" | paste -sd: -)"
real="$(PATH="$clean_path" command -v rsync)" || {
  echo "fakebin/rsync: no real rsync on PATH" >&2
  exit 127
}
exec "$real" "${args[@]}"
