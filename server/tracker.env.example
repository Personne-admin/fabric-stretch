# fabsim-track configuration. Copy to server/tracker.env and fill
# in the values marked REQUIRED. Alternatively keep the file anywhere and point
# FABSIM_TRACKER_ENV at it, or save it as ~/.config/fabsim/tracker.env.
# Variables already set in the environment win over this file.

# --- where the tracker runs ---------------------------------------------------

# ssh    = a GPU machine you reach over ssh (rsync is used to move files)
# local  = this machine has the GPU and the environment
# docker = this machine runs the tracker in a container (nvidia-container-toolkit)
TRACKER_MODE=ssh

# REQUIRED. Absolute directory that holds the tracker environment, the CoWTracker
# checkout, the checkpoint and (ssh mode) the uploaded inputs and the results.
# On the GPU host in ssh mode, on this machine in local/docker mode.
# Needs about 15 GB free. Letters, digits and . _ / + @ = - only.
TRACKER_ROOT=

# REQUIRED. Directory that contains your datasets: <dataset>/<run>/frames.json
# is addressed as "fabsim-track run <dataset>/<run>".
FABSIM_DATA_ROOT=

# --- ssh mode -----------------------------------------------------------------

# REQUIRED for ssh mode: user@host or an alias from ~/.ssh/config.
TRACKER_SSH_HOST=
# Optional private key (otherwise the ssh agent / default keys are used).
TRACKER_SSH_KEY=
# Optional jump host (ssh -J), e.g. user@gateway.example.org. A "ProxyJump" in
# ~/.ssh/config works as well.
TRACKER_SSH_JUMP=
# Optional extra ssh options, whitespace separated, e.g. "-4 -o Port=2222".
TRACKER_SSH_OPTS=

# --- tracking defaults ---------------------------

# GPU index (CUDA_VISIBLE_DEVICES) used for tracking, CoWTracker uses one GPU.
TRACKER_GPU=0
# Image role to track: the image_<role> key in frames.json.
TRACKER_ROLE=diffuse
# Point grid. 20 x 16 = 320 points per frame.
TRACKER_GRID_COLS=20
TRACKER_GRID_ROWS=16
# Extra adapter arguments for every run, whitespace separated (no quoting), e.g.
# "--windowed" for sequences longer than 200 frames. After "--" on the command
# line you can pass more.
TRACKER_EXTRA_ARGS=
# A result is valid when every point reconstructs its query position in the
# reference frame to within this many pixels. `run` passes the value to the
# adapter, which writes no results above it; `validate` checks the limit that
# is recorded in tracks.json.
TRACKER_REFERENCE_ERROR_LIMIT=2.0

# --- libraries on the GPU host ------------------------------------------------

# Directories (colon separated) prepended to LD_LIBRARY_PATH when tracking. Only
# needed if torch fails with a cuDNN / CUDA library error, see README.
TRACKER_LD_LIBRARY_PATH=
# Alternative: a prefix where setup installs a matching cuDNN with pip
# (nvidia-cudnn-cu13 --target <prefix>) and tracking puts it on LD_LIBRARY_PATH.
# Use a per-host directory when several hosts share TRACKER_ROOT over NFS.
TRACKER_CUDNN_PREFIX=

# --- local / docker mode ------------------------------------------------------

# Python used on THIS machine for dry-run, validate and the summary.
TRACKER_LOCAL_PYTHON=python3
# docker mode: image name that "fabsim-track setup" builds from server/Dockerfile.
TRACKER_DOCKER_IMAGE=fabsim-tracker
# Python executable of the tracker environment (default: $TRACKER_ROOT/env/bin/python).
# Set it for a conda environment you manage yourself.
TRACKER_PYTHON=

# --- what "setup" installs (see bootstrap.sh) ---------------------------------

# Interpreter used for the venv: python3.12 if available, else python3. The
# version must be at least TRACKER_PYTHON_VERSION.
TRACKER_PYTHON_VERSION=3.12
TRACKER_PYTHON_BIN=
# torch / torchvision / xformers come from the PyTorch wheel index (CUDA 13 build).
# Pick the index that matches the GPU driver: https://pytorch.org/get-started/locally/
TORCH_VERSION=2.13.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
TRACKER_XFORMERS_SPEC=xformers
# Second index for everything that is not a PyTorch wheel, and the packages.
TRACKER_PIP_EXTRA_INDEX_URL=https://pypi.org/simple
TRACKER_PIP_PACKAGES="timm==1.0.25 numpy scipy einops pillow opencv-python-headless huggingface_hub matplotlib"
# Minimum NVIDIA driver major version (CUDA 13 needs 580 or newer).
TRACKER_MIN_DRIVER=580

# Upstream CoWTracker.
COWTRACKER_REPO=https://github.com/facebookresearch/cowtracker.git
COWTRACKER_COMMIT=1454f20045d3b514e5b8417907152677f3dba621

# Model weights (CC-BY-NC-4.0, see NOTICE and docs/self_hosting_tracker.md) downloaded from the Hugging Face repo
# at a fixed revision and verified against the sha256 below.
CHECKPOINT_REPO=facebook/cowtracker
CHECKPOINT_FILE=cowtracker_model.pth
CHECKPOINT_REVISION=860b85cfb3a63b91780535689c262b3e595b6082
CHECKPOINT_URL=
CHECKPOINT_SHA256=5b46c6dac1d9f9f5944371176f5aedec13522db4ea86d998f3445b0fd37ab784
# Only needed if the repository is gated or private.
HF_TOKEN=
